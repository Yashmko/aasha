# AASHA backend configuration — copy to .env and fill in.
# (Config loader reads these; or set them as real env vars on your host.)

# Port + public URL
PORT=8000
BASE_URL=http://localhost:8000
# AASHA_DATA_DIR=./data

# --- AssemblyAI (sponsor tech) ---
# One key powers the agent BRAIN (LLM Gateway), real-time streaming STT,
# clinical notes, and post-call analytics. This is the only key you need.
AASHA_AAI_KEY=               # https://www.assemblyai.com
# AASHA_AAI_MODEL=qwen3.5-4b-32k-fast   # LLM Gateway model (optional override)

# --- Agent brain fallbacks (optional — you already get the brain from AASHA_AAI_KEY) ---
AASHA_GEMINI_KEY=            # free: https://aistudio.google.com/apikey
# AASHA_GEMINI_MODEL=gemini-2.0-flash
# AASHA_OPENAI_KEY=          # optional OpenAI-compatible fallback (groq/openai)
# AASHA_OPENAI_BASE=https://api.openai.com/v1
# AASHA_OPENAI_MODEL=gpt-4o-mini

# --- Outbound phone (optional) ---
AASHA_PHONE_PROVIDER=        # 'twilio'
# AASHA_TWILIO_SID=
# AASHA_TWILIO_TOKEN=
# AASHA_TWILIO_FROM=

# --- Family alerts ---
AASHA_ALERT_WEBHOOK=         # any push URL (Slack, Waypoint, your app)
# AASHA_WA_FROM=whatsapp:+1415...
# AASHA_FAMILY_NUMBER=+9198XXXXXXXX
